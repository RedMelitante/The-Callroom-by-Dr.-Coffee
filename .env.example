# Public URL of the site (canonical links, sitemap, social previews). Defaults to https://callroomcoffee.com
SITE_URL=https://callroomcoffee.com

# Optional: endpoint that receives orders and coffee cart booking requests as JSON (POST).
# e.g. a Formspree form URL, a Make/Zapier webhook or a Google Apps Script web app.
# When unset, orders and bookings open the customer's email app addressed to thecallroombydc@gmail.com.
PUBLIC_FORMS_ENDPOINT=
