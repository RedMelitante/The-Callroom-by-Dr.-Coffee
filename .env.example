# Public URL of the site (canonical links, sitemap, social previews). Defaults to https://callroomcoffee.com
SITE_URL=https://callroomcoffee.com

# Endpoint that receives orders and coffee cart booking requests as JSON (POST): the Google Apps Script
# web app URL from integrations/google-apps-script (emails requests, adds bookings to Google Calendar).
# When unset, orders and bookings open the customer's email app addressed to REQUESTS_TO in src/lib/site.js.
PUBLIC_FORMS_ENDPOINT=
