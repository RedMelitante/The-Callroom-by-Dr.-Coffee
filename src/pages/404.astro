---
import Base from '../layouts/Base.astro';
---

<Base title="Page not found">
  <main class="hero wrap notfound">
    <p class="eyebrow">404</p>
    <h1>Wrong room.</h1>
    <p class="lede">This page stepped out for a coffee and hasn't come back.</p>
    <div class="actions">
      <a class="btn btn-primary" href="/">Back to the callroom</a>
    </div>
  </main>
</Base>
